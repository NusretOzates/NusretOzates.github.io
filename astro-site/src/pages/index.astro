---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const talks = (await getCollection("talks")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const videos = await getCollection("videos");
const publications = await getCollection("publications");
const recentPosts = posts.slice(0, 3);
const recentTalks = talks.slice(0, 4);
const previewVideos = videos.slice(0, 2);

const socials = [
  { label: "GitHub", href: "https://github.com/NusretOzates" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/nusret-ozates/" },
  { label: "Email", href: "mailto:m.nusret.ozates@gmail.com" },
  { label: "Medium", href: "https://medium.com/@m.nusret.ozates" },
  { label: "YouTube", href: "https://youtube.com/@mnusretozates" },
];
---

<BaseLayout title="Nusret Özateş" description="Machine Learning Engineer — NLP, medical imaging, MLOps.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Machine Learning Engineer</p>
      <h1>Nusret Özateş</h1>
      <p class="lede">
        I build end-to-end ML systems — from data and training through deployment — with a focus on NLP, medical imaging, and MLOps.
      </p>
      <div class="cta-row">
        <a class="btn primary" href="/posts/">Read the blog</a>
        <a class="btn ghost" href="mailto:m.nusret.ozates@gmail.com">Get in touch</a>
      </div>
      <div class="social-row">
        {socials.map((s) => (
          <a href={s.href} target={s.href.startsWith("mailto") ? undefined : "_blank"} rel="noopener noreferrer">{s.label}</a>
        ))}
      </div>
    </div>
    <div class="hero-visual">
      <img src="/profile.jpeg" alt="Nusret Özateş" width="320" height="320" loading="eager" />
    </div>
  </section>

  <section class="section">
    <h2>Recent writing</h2>
    <ul class="post-list">
      {recentPosts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`}>
            <span class="post-title">{post.data.title}</span>
            <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}</time>
          </a>
        </li>
      ))}
    </ul>
    <a class="section-link" href="/posts/">All posts →</a>
  </section>

  <section class="section">
    <h2>Publications</h2>
    <div class="pub-list">
      {publications.map((pub) => (
        <article class="pub-card">
          <h3>{pub.data.title}</h3>
          <p class="pub-authors" set:html={pub.data.authors.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")} />
          <p class="pub-venue">{pub.data.venue}</p>
          <div class="pub-links">
            {pub.data.links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Videos</h2>
    <div class="video-grid">
      {previewVideos.map((video) => (
        <a class="video-card" href={`/videos/#playlist-${video.data.playlistId}`}>
          <img src={video.data.thumbnail} alt={video.data.title} loading="lazy" />
          <span>{video.data.title}</span>
        </a>
      ))}
    </div>
    <a class="section-link" href="/videos/">All videos →</a>
  </section>

  <section class="section">
    <h2>Recent talks</h2>
    <div class="talk-list">
      {recentTalks.map((talk) => (
        <article class="talk-card">
          <img src={`/${talk.data.image}`} alt={talk.data.title} loading="lazy" />
          <div>
            <h3>{talk.data.title}</h3>
            <p class="talk-meta">{talk.data.venue} · {talk.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</p>
            <p>{talk.data.description}</p>
            <a href={talk.data.href} target="_blank" rel="noopener noreferrer">LinkedIn Post</a>
          </div>
        </article>
      ))}
    </div>
    <a class="section-link" href="/talks/">All talks →</a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
    max-width: 72rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
    background: var(--hero-glow);
    min-height: min(88vh, 720px);
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    margin: 0 0 1rem;
    line-height: 1.05;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 42ch;
    margin: 0 0 1.75rem;
  }
  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .btn.primary {
    background: var(--accent);
    color: white;
  }
  .btn.primary:hover {
    background: var(--accent-hover);
    color: white;
  }
  .btn.ghost {
    border: 1px solid var(--accent);
    color: var(--accent);
  }
  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .social-row a {
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .hero-visual img {
    width: min(280px, 40vw);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  .section {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .section h2 {
    font-size: 1.5rem;
    margin: 0 0 1.5rem;
  }
  .section-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-list li a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
  }
  .post-list li a:hover .post-title {
    color: var(--accent);
  }
  .post-list time {
    color: var(--text-muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .pub-card {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin-bottom: 0.5rem;
  }
  .pub-card h3 {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }
  .pub-authors, .pub-venue {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 0.35rem;
  }
  .pub-links a {
    font-size: 0.8rem;
    margin-right: 0.5rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--accent);
    border-radius: 4px;
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .video-card {
    color: var(--text);
    text-decoration: none;
  }
  .video-card img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }
  .talk-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .talk-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .talk-card img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: 8px;
  }
  .talk-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
  }
  .talk-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }
  .talk-card p {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      min-height: auto;
      padding-top: 2.5rem;
    }
    .lede { margin-inline: auto; }
    .cta-row, .social-row { justify-content: center; }
    .hero-visual { order: -1; }
    .hero-visual img { width: 180px; margin: 0 auto; }
    .talk-card { grid-template-columns: 1fr; }
  }
</style>
