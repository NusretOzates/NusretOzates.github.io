---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you requested does not exist.">
  <div class="not-found">
    <h1>404</h1>
    <p>The page you are looking for does not exist.</p>
    <a href="/">Back to home</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: 52rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  .not-found h1 {
    margin: 0 0 0.5rem;
    font-size: 4rem;
    color: var(--accent);
  }
  .not-found p {
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }
</style>
