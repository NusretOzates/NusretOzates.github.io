{
  "name": "astro-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run pagefind:sync && astro dev",
    "build": "astro build && npx pagefind --site ../docs",
    "pagefind:sync": "mkdir -p public && rm -rf public/pagefind && test -d ../docs/pagefind && cp -r ../docs/pagefind public/pagefind || true",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.1.6",
    "astro-expressive-code": "^0.44.1",
    "pagefind": "^1.5.2",
    "zod": "^4.4.3"
  }
}
